(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  h j k l e lctl lalt caps
  lsft lmet f23
)

(defvar
  tap-time 150
  hold-time 150
  chord-window 50 ;; all keys of chord should press inside the window
)

(defalias
  ralt-nav (layer-toggle nav)

  ;; Caps Lock tap=esc, hold=nav layer
  caps-mod (tap-hold $tap-time $hold-time esc @ralt-nav)

  ;; Caps+E: sends Super+Shift+E which GNOME catches via custom shortcut
  switch-files (multi lmet lsft e)
)

(defchordsv2-experimental
  (lsft lmet f23) (one-shot 1500 lctl) $chord-window all-released ()
)

(deflayer base
  h    j    k    l    e
  lalt lctl @caps-mod
  _    _    _
)

(deflayer nav
  left  down  up   right  @switch-files
  lalt lctl    _
  _    _    _    _
)
