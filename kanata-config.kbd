(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  h j k l f e g c a v t n lctl lalt caps
  lsft lmet f23
)

(defvar
  tap-time 150
  hold-time 150
  chord-window 50 ;; all keys of chord should press inside the window
)

(defalias
  ralt-nav (layer-toggle nav)
  
  ;; Caps Lock tap=esc, hold=nav layer 
  caps-mod (tap-hold $tap-time $hold-time esc @ralt-nav)

  ;; Application switch aliases
  switch-ff (multi lmet lsft f)
  switch-files (multi lmet lsft e)
  switch-gemini (multi lmet lsft g)
  switch-chatgpt (multi lmet lsft c)
  switch-antigravity (multi lmet lsft a)
  switch-code (multi lmet lsft v)
  switch-notion (multi lmet lsft n)
  
  ;; Using Super+Shift+Y for Ghostty to avoid screenshot conflict
  switch-ghostty (multi lmet lsft y)
)

;; Stable chords setup.
;; Added one-shot so a quick hardware macro properly holds Control.
;; When there is a quick release of copilot key, ctrl is sent for 1.5 seconds
(defchordsv2
  (lsft lmet f23) (one-shot 1500 lctl) $chord-window all-released ()
)

(deflayer base
  h    j    k    l    f    e    g    c    a    v    t    n
  lalt lctl @caps-mod
  _    _    _
)

(deflayer nav
  left  down  up   right @switch-ff @switch-files @switch-gemini @switch-chatgpt @switch-antigravity @switch-code @switch-ghostty @switch-notion
  lalt lctl    _
  _    _    _
)
